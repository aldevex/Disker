# Disker commands prototype

# Enable auto-confirmation and binary units (GB = GiB, etc.)
autoyes # Opposite "manyes"
binary # Opposite "decimal"

# Select disk to operate on (via path or symbol pointing to a partition or disk or image file)
select D:/

# If selecting an image that doesn't save sector size (e.g. ".img"),
#   you can specify sector size on "select"
# select x.img sectsize 4096

# Use "create" to always create a new image file
# create eee.vhd

# Set new/Edit disk layout
disk size 32GiB sectsize 4096B align 1MiB \
    scheme GPT parts 256 sparse false
# Available schemes: MBR, GPT, and Hybrid

# Set partitions
part 1  size 8GiB        label "UEFI slop"       type ESP  guid "eeeeeeee-EEee-eEEe-eeFF-eeeeeefffeee" \
            fslabel "UEFI stuff"        spc 2
part 2  sects 2,097,152  label "OS Partition"    type FAT32
            fslabel "Operating Zyztem"  spc 1 
part 3  size auto        label "Data partition"  type exfat

# Set MBR bootloader code
boot mbr boot_mbr.bin
# Also available: "boot align <file name>" (binary copied into empty alignment space after MBR and GPT)

# Select partition to operate on in bootloader and filesystem commands
select part 1
# You can NOT edit selected partition by using "part" without a number:
# 🚫🚫🚫 part    spc 1  size 8GiB  fs FAT32  guid ESP 🚫🚫🚫

# Set VBR and EFI bootloader for selected partition
boot vbr boot_vbr.bin
boot uefi_default boot_uefi.EFI
copy out "boot_uefi.EFI" "EFI\ShitOS\boot\boot_x64.EFI" # Copy from outside (OS FS) to inside (disk FS)

# All file stuff is available:
# cd: Change directory if given an argument, prints current directory otherwise
# list: List directory contents or print file content
# tree: List directory contents, including nested ones
# find: Search for a file or directory by name or path segment
# create: Creates a file or directory
# delete: Deletes a file or directory
# copy: Copies a file or a directory with its contents
# move: Moves a file or a directory with its contents
# rename: Renamed a file or directory
# attribs: Get file system attributes for a file or directory

# Get info about selected subjects
info boot # List info on each bootloader
info part # List selected partition info
info part <n> # List specified partition info
info disk # List selected disk info
info disk <path/symbol> # List specified disk info
info sys # Lists all system disks

# Only on save does Disker overwrite the selected disk with the given commands
save
# After parsing "save" it asks for confirmation

# Close the selected disk
close

# Exit Disker
quit # Can use "stop" or "exit" or "quit"

# Program warns on exit, close, or selecting disk with unsaved commands
# "undo" and "redo" are available only for terminal line-by-line input
